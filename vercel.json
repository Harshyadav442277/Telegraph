{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": null,
  "outputDirectory": "public",
  "functions": {
    "api/index.ts": {
      "maxDuration": 30,
      "memory": 1024,
      "includeFiles": "telegraph/**"
    }
  },
  "rewrites": [
    { "source": "/health", "destination": "/api/index" },
    { "source": "/healthz", "destination": "/api/index" },
    { "source": "/ready", "destination": "/api/index" },
    { "source": "/miner.yaml", "destination": "/api/index" },
    { "source": "/ssl-check", "destination": "/api/index" },
    { "source": "/v1/ssl-check", "destination": "/api/index" }
  ]
}
